# Copy to .env (chmod 600). DNS A/AAAA records for both domains must point at the VM before the first start (TLS).
APP_DOMAIN=platform.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

# Image published by CI (linux/amd64): pin a commit SHA or release tag for reproducible upgrades.
PLATFORM_IMAGE=ghcr.io/asteriusit/asterius-platform:latest

# Generate each with: openssl rand -base64 32 | tr -d '/+=' (no URL-special characters: used inside DATABASE_URL)
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
# openssl rand -base64 32 (encrypts stored secrets: back it up, losing it makes them unreadable)
SECRETS_KEY=

# keycloak, optionally plus local (email + password break-glass account)
AUTH_PROVIDERS=keycloak
# Platform super-admins
ADMIN_EMAILS=you@example.com
# true: Keycloak admin console reachable at https://$AUTH_DOMAIN/admin (turn on only while you need it)
KEYCLOAK_EXPOSE_ADMIN=false

# ANTHROPIC_API_KEY=
# LOG_LEVEL=info
