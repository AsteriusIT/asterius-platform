{
  "title": "Asterius Platform",
  "uid": "asterius-platform",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "asterius"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(asterius_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(asterius_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(asterius_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(asterius_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Run queue (cluster)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (asterius_queue_runs)",
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
          "expr": "max(asterius_queue_oldest_run_age_seconds)",
          "legendFormat": "oldest queued (s)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Runs finished by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(asterius_runs_finished_total[15m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Seconds since last successful sync",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (integration) (asterius_integration_last_success_timestamp_seconds)",
          "legendFormat": "{{integration}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sync duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, integration) (rate(asterius_sync_duration_seconds_bucket[1h])))",
          "legendFormat": "{{integration}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhook deliveries by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(asterius_webhook_deliveries_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Webhook delivery latency p95 / backlog age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(asterius_webhook_delivery_latency_seconds_bucket[15m])))",
          "legendFormat": "p95 latency"
        },
        {
          "refId": "B",
          "expr": "max(asterius_queue_oldest_delivery_age_seconds)",
          "legendFormat": "oldest due delivery"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB pool (per pod)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asterius_db_pool_connections",
          "legendFormat": "{{pod}} open"
        },
        {
          "refId": "B",
          "expr": "asterius_db_pool_waiting_requests",
          "legendFormat": "{{pod}} waiting"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream responses / rate limited",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, class) (rate(asterius_upstream_responses_total[5m]))",
          "legendFormat": "{{host}} {{class}}"
        },
        {
          "refId": "B",
          "expr": "sum by (host) (rate(asterius_upstream_rate_limited_total[5m]))",
          "legendFormat": "{{host}} 429"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker loop age (per pod)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - asterius_worker_loop_last_success_timestamp_seconds",
          "legendFormat": "{{pod}} {{loop}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Catalog entities",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (blueprint) (asterius_catalog_entities)",
          "legendFormat": "{{blueprint}}"
        }
      ]
    }
  ]
}