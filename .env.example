# ---------- Platform ----------
PUBLIC_URL=http://localhost:5173
# all (API + workers, default) | api | worker
# PLATFORM_ROLE=all
# Empty: SQLite under DATA_DIR (local development). Production: PostgreSQL.
# DATABASE_URL=postgres://platform:secret@localhost:5432/platform
# 32 bytes (base64 or hex) encrypting stored secrets. Generated under DATA_DIR with SQLite; required with Postgres.
#   openssl rand -base64 32
# SECRETS_KEY=
# Configuration as code (blueprints, actions, integrations, webhooks, teams). Default: ./config
# CONFIG_DIR=
# LOG_LEVEL=info
# BRAND_NAME=Asterius Platform
# BRAND_LOGO=https://example.com/logo.svg
# METRICS_TOKEN=

# ---------- Sign-in ----------
# local (email + password), entra (Microsoft Entra ID, default organization) and/or keycloak (registration, login and
# per-organization SSO), comma-separated
AUTH_PROVIDERS=local
ALLOW_REGISTRATION=true
# Bootstrap admins (the first local account is admin when no admin exists)
# ADMIN_EMAILS=alice@example.com
# scripts/entra-app.sh creates the app registration and fills these:
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=          # default ${PUBLIC_URL}/api/auth/entra/callback
# ENTRA_ADMIN_GROUPS=          # Entra group object ids whose members are admins

# Keycloak (docker compose -f deploy/keycloak/docker-compose.yaml up -d gives a ready realm on :8180)
# KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_INTERNAL_URL=       # back-channel URL when it differs (in-cluster service)
# KEYCLOAK_REALM=asterius
# KEYCLOAK_CLIENT_ID=asterius-platform
# KEYCLOAK_CLIENT_SECRET=dev-secret-change-me

# ---------- Organizations (tenants) ----------
# everyone (self-service sign-up) | superadmin
# ORG_CREATION=everyone
# true: new accounts join the default organization (single-tenant). Default: no organization until they create one,
# are invited, or sign in through an organization's SSO
# AUTO_JOIN_DEFAULT_ORG=false
# Organizations allowed to use the platform's own Kubernetes access (source, Job and Tekton invokers)
# KUBERNETES_ORGS=default
# Organizations allowed to use the platform's own cloud identity (external secret managers, credential-less auth blocks)
# PLATFORM_IDENTITY_ORGS=default

# ---------- Workers ----------
# WORKER_CONCURRENCY=8         # concurrent action runs per worker process
# RUN_POLL_SECONDS=15          # status polling of pipelines / jobs
# RUN_TIMEOUT_HOURS=24
# HTTP_TIMEOUT_SECONDS=30
# RETENTION_DAYS=90            # runs, deliveries, sync history, audit
# KUBECONFIG_PATH=             # Kubernetes source / Job invoker outside a cluster

# ---------- AI agent steps (Claude) ----------
# Workflow steps of type `agent` call Claude with this key (a step may use its own: apiKey: ${secret:NAME}).
# ANTHROPIC_API_KEY=
# AGENT_DEFAULT_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=          # optional gateway / proxy
# Per-team key: create the secret `anthropic-api-key-<team>`; a step's apiKey wins over it, the platform key is the fallback.
# AI_PROVIDER=anthropic        # anthropic | bedrock | vertex (credentials from the standard AWS / Google environment)
# AI_REGION=                   # Bedrock / Vertex region
# AI_VERTEX_PROJECT=
# AI_ASSISTANT_MODEL=claude-sonnet-5-5   # catalog questions, run explanations, authoring drafts, reviews
# AI_PRICES={"claude-opus-5-5":{"input":4,"output":20,"cacheWrite":5,"cacheRead":0.4}}   # $/MTok, overrides the built-in table
# AI_REVIEW_INTERVAL_HOURS=0   # scheduled catalog quality review (0: off)
# AI_REVIEW_STALE_DAYS=180
# The platform is also an MCP server: POST /api/v1/mcp with an API token (Authorization: Bearer ast_…).

# ---------- Values referenced by configuration as ${env:NAME} ----------
# GITHUB_TOKEN=

# ---------- Tracing (OpenTelemetry, OTLP/HTTP) ----------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=asterius-platform
