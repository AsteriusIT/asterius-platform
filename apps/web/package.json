{
  "name": "@asterius/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --project=functional",
    "e2e:visual": "playwright test --project=visual",
    "e2e:update": "playwright test --project=visual --update-snapshots",
    "icons:vendor": "node scripts/gen-vendor-icons.mjs && prettier --write src/components/vendorIcons.generated.ts"
  },
  "devDependencies": {
    "@asterius/brand": "*",
    "@asterius/shared": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/devicon": "^1.2.79",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/simple-icons": "^1.2.102",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.7.5",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@playwright/test": "^1.65.0",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "description": "Bundled by Vite into static files served by the API: every package is a build-time dependency.",
  "dependencies": {
    "@xyflow/react": "^12.12.1"
  }
}
